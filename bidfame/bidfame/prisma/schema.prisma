// BIDFAME database schema
// Postgres (Supabase) + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BidStatus {
  PENDING // invoice created, waiting for Telegram payment
  SUCCESS // confirmed via successful_payment webhook update
  FAILED // pre_checkout rejected, or superseded before payment completed
  EXPIRED // invoice went stale (someone else took the spot first)
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id         String   @id @default(cuid())
  telegramId String   @unique // Telegram numeric user id, stored as string for safety
  username   String?
  firstName  String?
  lastName   String?
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listings Listing[]
  bids     Bid[]
  payments Payment[]

  @@index([telegramId])
}

model Listing {
  id          String   @id @default(cuid())
  userId      String
  name        String
  instagram   String
  website     String?
  description String?
  imageUrl    String?
  currentBid  Int      @default(0) // in Telegram Stars
  bidCount    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  bids     Bid[]
  payments Payment[]

  @@index([userId])
  @@index([active, currentBid])
}

model Bid {
  id                 String    @id @default(cuid())
  listingId          String
  userId             String
  amountStars        Int
  previousBid        Int
  telegramPaymentId  String? // invoice_payload we generated (unique per attempt)
  telegramChargeId   String? // telegram_payment_charge_id from successful_payment
  status             BidStatus @default(PENDING)
  createdAt          DateTime  @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  payment Payment?

  // A given Telegram charge can only ever back one bid — hard stop against
  // double-processing the same payment.
  @@unique([telegramChargeId])
  @@index([listingId, createdAt])
  @@index([userId])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  listingId         String
  bidId             String        @unique
  amountStars       Int
  telegramPaymentId String? // our invoice_payload
  telegramChargeId  String? // telegram_payment_charge_id
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  bid     Bid     @relation(fields: [bidId], references: [id])

  // Prevents the same Telegram charge from ever being recorded twice.
  @@unique([telegramChargeId])
  @@index([listingId])
  @@index([userId])
}
