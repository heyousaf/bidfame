# Supabase Postgres connection (pooled, for the app at runtime)
DATABASE_URL=

# Supabase Postgres direct connection (unpooled, required by Prisma for migrations)
DIRECT_URL=

# From @BotFather when you create your bot
TELEGRAM_BOT_TOKEN=

# Your deployed Vercel URL for the Mini App, e.g. https://bidfame.vercel.app
TELEGRAM_WEBAPP_URL=

# Any long random string you generate yourself — used to verify webhook requests really come from Telegram
TELEGRAM_WEBHOOK_SECRET=

# Your personal Telegram numeric user ID (get it from @userinfobot) — only this ID can access /admin
ADMIN_ID=

# From Supabase Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
